# Optional settings. Copy this file to .env for local use, or set the same names in your hosting dashboard.
# They are read when the site is BUILT, so after changing one on a host, trigger a new deploy.

# A link to your feedback form (Google Forms, Typeform...). Adds an "Open the feedback form" button.
VITE_FEEDBACK_URL=

# Your email address. Adds a "Send feedback by email" button that opens the reviewer's email app.
VITE_FEEDBACK_EMAIL=

# Where anonymous usage data is sent, only for players who opt in. Leave empty to collect nothing.
VITE_TELEMETRY_URL=

# Your contact email, shown on the privacy policy, terms and About pages.
VITE_CONTACT_EMAIL=

# AI NPC chat (optional). The URL of your AI proxy, e.g. https://your-site.vercel.app/api/npc
# The AI key itself is NEVER put here: it goes in the host's server environment as AI_API_KEY (see docs/AI_NPCS.md).
VITE_AI_URL=
# Daily AI chats per player, shown in the game (the server enforces its own limit too)
VITE_AI_LIMIT=20
